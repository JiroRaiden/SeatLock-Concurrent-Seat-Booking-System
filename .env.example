# =============================================================================
# Copy to .env and fill in. .env is gitignored; this template is committed so a
# new developer (or future you) knows exactly which variables exist.
#
# Generate a JWT secret with:
#   openssl rand -base64 32
# =============================================================================

SPRING_PROFILES_ACTIVE=dev

# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/seatlock
DB_USERNAME=seatlock
DB_PASSWORD=change_me
DB_POOL_SIZE=20

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Security ----
# MUST be a base64-encoded value of at least 32 bytes (256 bits) for HS256.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Rate limits (requests per minute, per client IP) ----
RATE_LIMIT_AUTH=10
RATE_LIMIT_HOLD=30

# ---- Booking rules ----
HOLD_TTL=8m
HOLD_EXTENSION=3m
MAX_SEATS_PER_BOOKING=10

# ---- Frontend build ----
VITE_API_BASE_URL=http://localhost:8080
